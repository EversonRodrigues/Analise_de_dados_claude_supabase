# Modelo dos secrets do Streamlit Community Cloud.
#
# NAO comite o arquivo real. No deploy, cole este conteudo (com os valores
# preenchidos) em: app no share.streamlit.io > Settings > Secrets.
#
# Para rodar localmente lendo de secrets em vez de .env.local, salve como
# .streamlit/secrets.toml na raiz do projeto — ja coberto pelo .gitignore.
#
# Use SOMENTE a chave publicavel/anon. A service_role ignora RLS e nunca deve
# sair de um backend.

NEXT_PUBLIC_SUPABASE_URL = "https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY = "<chave publicavel>"
